# ==========================================================
# GigaChat API Configuration (Example)
# Скопируйте этот файл в `api.env` и укажите ваш ключ авторизации
# ==========================================================

# 1. Авторизационные данные (длинная строка base64 из кабинета Salute / Сбера)
GIGACHAT_CREDENTIALS=ваш_токен_авторизации

# 2. Область доступа:
# Для физических лиц: GIGACHAT_API_PERS
# Для корпоративных клиентов / организаторов хакатона: GIGACHAT_API_B2B или GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# 3. Отключение строгой проверки SSL (критично для Windows)
GIGACHAT_VERIFY_SSL_CERTS=false

# 4. Модели (по умолчанию: GigaChat или GigaChat-Pro)
GIGACHAT_MODEL_LITE=GigaChat
GIGACHAT_MODEL_MAX=GigaChat-Max
